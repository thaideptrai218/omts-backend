# Local Docker environment (docker-compose.yml). Copy to .env, which git ignores: cp .env.example .env
# These values are for your own machine only. docker-compose is never the shared server: a shared server runs in
# Staging with secrets of its own (README "Demo on a shared server").

# SQL Server "sa" password: at least 8 characters from three of upper case, lower case, digits and symbols.
# Do not use ';' or '"' (it goes into a connection string).
MSSQL_SA_PASSWORD=Local-Dev-1

# JWT signing key, at least 32 bytes. To generate another one: openssl rand -base64 48
JWT_SIGNING_KEY=local-dev-local-dev-local-dev-local-dev

# Signs the file download links, at least 32 bytes. To generate another one: openssl rand -base64 48
STORAGE_SIGNING_KEY=local-dev-local-dev-local-dev-local-dev

# Temporary password of the first Cooperative Owner (at least 8 characters with a letter and a digit). The demo
# seed then sets the Owner's demo password (README "Run with Docker").
OWNER_TEMPORARY_PASSWORD=Owner-Temp-1

# Redis password (revoked-session lookup). Letters and digits only: it goes into a connection string, so no ',' ';' or '"'.
# To generate another one: openssl rand -hex 24
REDIS_PASSWORD=local-dev-redis-1
