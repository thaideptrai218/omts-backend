<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7d411920-193a-4e1b-83ec-b463c8e3492b</UserSecretsId>
    <!-- XML comments feed Swagger (Extensions/SwaggerSetup). Not every public member needs one: CS1591 is off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- 6.8+ looks the XML comments up in a dictionary. 6.6.2 scanned the whole file for every type and endpoint: swagger.json took
         20+ s (585 endpoints, 3 MB of comments), longer than CloudFront waits (504) and enough to pin a core on the 2-vCPU staging host. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OMTS.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OMTS.Application\OMTS.Application.csproj" />
    <ProjectReference Include="..\OMTS.Infrastructure\OMTS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
