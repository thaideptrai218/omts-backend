<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OMTS.Application\OMTS.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OMTS.Api.IntegrationTests" />
    <InternalsVisibleTo Include="OMTS.Infrastructure.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.410.4" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="7.1.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- PDF reports. Community license (free under USD 1M yearly revenue), set in ReportDocumentPdfRenderer. -->
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
    <!-- MimeKit 4.18.1 brings System.Security.Cryptography.Pkcs 10.0.0; this raises it to the current servicing
         release, which carries the security fixes. Keep it unless MimeKit itself references a newer one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Noto Sans (SIL Open Font License 1.1): embedded so the PDF never depends on the fonts installed in the container. -->
  <ItemGroup>
    <EmbeddedResource Include="Reports\Fonts\NotoSans-Regular.ttf" LogicalName="OMTS.Fonts.NotoSans-Regular.ttf" />
    <EmbeddedResource Include="Reports\Fonts\NotoSans-Bold.ttf" LogicalName="OMTS.Fonts.NotoSans-Bold.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
